<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SoapCore" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Explicit reference overrides the transitive Microsoft.OpenApi 2.0.0
         (vulnerable per GHSA-v5pm-xwqc-g5wc) pulled in via Microsoft.AspNetCore.OpenApi. -->
    <PackageReference Include="Microsoft.OpenApi" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuickApiMapper.Host.ServiceDefaults\QuickApiMapper.Host.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
